[Unit]
# Lighter spot/perp basis logger - read-only Phase 0 collector
# (bot-strategy#573). Separate observe-only unit; does NOT touch
# debot-pair-btceth.
Description=Lighter spot/perp basis logger (read-only, bot-strategy#573)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/rwa-logger/bin/lighter-basis-logger
Environment=RUST_LOG=info
Environment=LIGHTER_BASIS_LOG_DIR=/opt/debot-rwa
Environment=LIGHTER_BASIS_POLL_SECS=10
Environment=LIGHTER_BASIS_ORDERBOOK_LIMIT=100
Environment=LIGHTER_BASIS_DEPTH_BPS=25
# Lighter has spot+perp overlap for 7 symbols, but only ETH is clean enough for
# the primary readout; LIT is kept as a high-basis venue-token monitor.
Environment=LIGHTER_BASIS_MARKETS=ETH:2048:0,LIT:2049:120
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
