[Unit]
# RWA spot price logger — read-only Phase 0 collector (bot-strategy#574).
# Separate observe-only unit; does NOT touch debot-pair-btceth.
Description=RWA spot price logger (read-only, bot-strategy#574)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/rwa-logger/bin/rwa-spot-logger
Environment=RUST_LOG=info
Environment=RWA_LOG_DIR=/opt/debot-rwa
Environment=RWA_POLL_SECS=10
# Public Jupiter-verified SPL mints (bot-strategy#574 comment). xStocks majors
# (#568 sector pairs) + SpaceX 4-issuer (#564 multi-issuer convergence).
# SPACEXpre is the PreStocks wrapper with a hard forced-conversion deadline
# (2027-03-12) — the contractual-convergence leg #564 was actually filed to
# test; it verifies via https://lite-api.jup.ag/tokens/v2/search?query=SPACEX
# (isVerified=true, tags include "prestocks", firstPool 2025-09). CAUTION:
# its Jupiter price/v3 response carries a scaledUiConfig entry (multiplier=1,
# newMultiplier=5, newMultiplierEffectiveAt=2026-06-10, already past) whose
# effect on usdPrice is NOT verified here — usdPrice ($84.35) and the shared
# stockData.price anchor ($116.49) disagreed by ~28% at logger-add time,
# unlike SPCX/SPCXx (usdPrice tracks stockData.price closely). Resolve this
# unit question with real logged data before treating any SPACEXpre spread
# number as a genuine dislocation rather than a scaling artifact.
Environment=RWA_TOKENS=TSLAx:XsDoVfqeBukxuZHWhdvWHBhgEHjGNst4MLodqsJHzoB,NVDAx:Xsc9qvGR1efVDFGLrVsmkzv3qi45LTBjeUKSPmx9qEh,AAPLx:XsbEhLAtcf6HdfpFZ5xEMdqW8nfAvcsP5bdudRLJzJp,METAx:Xsa62P5mvPszXL1krVUnU5ar38bBSVcWAB6fmPCo5Zu,SPYx:XsoCS1TfEyfFhfvj8EtZ528L3CaKBDBRqRapnBbDF2W,MSTRx:XsP7xzNPvEHS1m6qfanPUGjNmdnmsLKEoNAnHjdxxyZ,SPCX:SPCXxcqXj6e5dJDVNovHN8744zkbhM2bYudU45BimGb,SPCXx:Xs3oZwbHvqis4NYcf4YKWmEia2eC84wSiVrcYcTqpH8,SPCXon:wzAyQTorWyoVXuJKj2x8EqKEGJpS13z6EWE9z5Aondo,SPACEXpre:PreANxuXjsy2pvisWWMNB6YaJNzr7681wJJr2rHsfTh
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
