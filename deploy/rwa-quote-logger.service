[Unit]
# RWA executable quote-status logger — read-only Project 5 collector.
# Separate observe-only unit; does NOT touch debot-pair-btceth.
Description=RWA quote-status logger (read-only, bot-strategy#592)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/rwa-logger/bin/rwa-quote-logger
Environment=RUST_LOG=info
Environment=RWA_QUOTE_LOG_DIR=/opt/debot-rwa
Environment=RWA_QUOTE_POLL_SECS=120
Environment=RWA_QUOTE_REQUEST_GAP_MS=250
Environment=RWA_QUOTE_NOTIONALS_USD=25,100,500
# Public Jupiter-verified SPL mints with decimals. Mirrors rwa-spot-logger
# labels so price-only dislocations can be compared against executable quotes.
Environment=RWA_QUOTE_TOKENS=TSLAx:XsDoVfqeBukxuZHWhdvWHBhgEHjGNst4MLodqsJHzoB:8,NVDAx:Xsc9qvGR1efVDFGLrVsmkzv3qi45LTBjeUKSPmx9qEh:8,AAPLx:XsbEhLAtcf6HdfpFZ5xEMdqW8nfAvcsP5bdudRLJzJp:8,METAx:Xsa62P5mvPszXL1krVUnU5ar38bBSVcWAB6fmPCo5Zu:8,SPYx:XsoCS1TfEyfFhfvj8EtZ528L3CaKBDBRqRapnBbDF2W:8,MSTRx:XsP7xzNPvEHS1m6qfanPUGjNmdnmsLKEoNAnHjdxxyZ:8,SPCX:SPCXxcqXj6e5dJDVNovHN8744zkbhM2bYudU45BimGb:6,SPCXx:Xs3oZwbHvqis4NYcf4YKWmEia2eC84wSiVrcYcTqpH8:8,SPCXon:wzAyQTorWyoVXuJKj2x8EqKEGJpS13z6EWE9z5Aondo:9
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
